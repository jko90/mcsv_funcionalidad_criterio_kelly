# ================================
# CONFIGURACIÓN BÁSICA
# ================================
Options -Indexes
ServerSignature Off

# ================================
# HEADERS DE SEGURIDAD Y CORS
# ================================
<IfModule mod_headers.c>
    # CORS Headers
    Header always set Access-Control-Allow-Origin "http://localhost:8100"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Max-Age "3600"
    
    # Protección XSS
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevenir MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Protección contra clickjacking
    Header always set X-Frame-Options "DENY"
    
    # Política de referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' cdnjs.cloudflare.com; font-src 'self' cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self' http://localhost:8100"
    
    # Remove server info
    Header always unset Server
    Header always unset X-Powered-By
</IfModule>

# ================================
# COMPRESIÓN GZIP
# ================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# ================================
# CACHE CONTROL (solo JSON no cacheable)
# ================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ================================
# PROTECCIÓN DE ARCHIVOS SENSIBLES
# ================================
<Files ~ "^(\.htaccess|\.htpasswd|\.env|enlace\.php|global\.php)$">
    Require all denied
</Files>

<FilesMatch "\.(inc|enlace|conf|config)$">
    Require all denied
</FilesMatch>

# ================================
# URL REWRITING PARA API REST
# ================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Manejo de CORS preflight
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ index.php [L,R=200]
    
    # Bloquear acceso directo a carpetas internas (403)
    RewriteRule ^/?(configuracion|rutas|modelos|controladores|logs)(/.*)?$ - [F,L]
    
    # Redirigir todas las peticiones que no sean archivos o directorios a index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
    
    # Force HTTPS (descomenta si tienes SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Trailing slash redirect
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !/$
    RewriteCond %{REQUEST_URI} !^/rest_divisas/(cripto|forex|indice|sinteticos|otros)
    RewriteRule ^(.*)$ $1/ [L,R=301]
</IfModule>

# ================================
# PÁGINAS DE ERROR PERSONALIZADAS
# ================================
ErrorDocument 400 /rest_divisas/errors/400.html
ErrorDocument 401 /rest_divisas/errors/401.html
ErrorDocument 403 /rest_divisas/errors/403.html
ErrorDocument 404 /rest_divisas/errors/404.html
ErrorDocument 500 /rest_divisas/errors/500.html

# ================================
# CONFIGURACIÓN PHP
# ================================
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_vars 3000
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log logs/php_errors.log
</IfModule>

# ================================
# TIPOS MIME
# ================================
<IfModule mod_mime.c>
    AddType application/json .json
</IfModule>
