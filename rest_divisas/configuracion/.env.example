# ================================
# CONFIGURACIÓN rest_divisas
# ================================
# Copiar este archivo como .env y ajustar los valores.
# ¡Nunca versionar .env!

# API Key de Financial Modeling Prep (obligatorio para /indice)
FMP_API_KEY=tu_api_key_aqui

# Origen CORS permitido (frontend SPA)
CORS_ORIGIN=http://localhost:8100

# Versión del servicio
APP_VERSION=1.0.0

# TTL de caché en segundos (valores por defecto: 30 para cripto, 60 para forex e índices)
CACHE_TTL_CRIPTO=30
CACHE_TTL_FOREX=60
CACHE_TTL_INDICE=60
