# Configuración de rest_usuario. Copie este archivo como .env y complete los valores.
# El archivo .env nunca se versiona. Ver README, sección "Ambiente local".
APP_ENTORNO=local
DB_HOST=localhost
DB_PUERTO=3306
DB_NOMBRE=sist_criteriokelly
DB_USUARIO=ck_aplicacion
DB_CLAVE=
DB_CHARSET=utf8mb4
CORS_ORIGENES_WEB=http://localhost:8100,http://localhost:4200
CORS_ORIGENES_NATIVOS=capacitor://localhost,https://localhost
IP_CABECERA_CONFIABLE=
IP_PROXIES_CONFIABLES=
RUTA_LOGS=logs
FORZAR_HTTPS=false
TOKEN_ACCESO_MINUTOS=15
TOKEN_REFRESH_INACTIVIDAD_DIAS=7
TOKEN_REFRESH_MAXIMO_DIAS=30
COOKIE_REFRESH_NOMBRE=ck_refresh
COOKIE_REFRESH_RUTA=/mcsv_funcionalidad_criterio_kelly/rest_usuario/autenticacion/
COOKIE_REFRESH_SEGURA=true
# ===== Correo =====
# CORREO_MODO elige como sale el correo: log, smtp o mail. Mapa del modulo y de quien envia: correo/README.md
#   log:  solo con APP_ENTORNO=local. No envia nada: escribe en logs/correos/ (correos.log y un correo-*.txt por correo).
#   smtp: cuenta SMTP real, local o produccion. Usa SMTP_HOST, SMTP_PUERTO, SMTP_USUARIO, SMTP_CLAVE y SMTP_CIFRADO
#         (Gmail: smtp.gmail.com, 587, tls, contrasena de aplicacion).
#   mail: funcion mail() de PHP; solo en un hosting con servicio de correo propio, y CORREO_REMITENTE debe ser de su dominio.
#         Se ignoran los SMTP_*, pero SMTP_HOST y SMTP_PUERTO deben tener un valor valido.
CORREO_MODO=log
SMTP_HOST=localhost
SMTP_PUERTO=1025
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_CIFRADO=ninguno
CORREO_REMITENTE=no-responder@localhost
CORREO_REMITENTE_NOMBRE="Criterio Kelly"
CORREO_ALERTAS=alertas@ejemplo.test
# ===== Fin de Correo =====
RUTA_CLAVES_COMUNES=configuracion/claves_comunes.txt
